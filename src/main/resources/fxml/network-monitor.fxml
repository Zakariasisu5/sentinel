<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sentinel.controller.NetworkController" styleClass="page-scroll">
    <content>
        <VBox spacing="22" styleClass="page-root">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
                <VBox spacing="5">
                    <Label text="Network monitor" styleClass="page-title"/>
                    <Label text="Inspect network connection observations saved to the local database." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="NO LIVE CAPTURE" styleClass="mini-badge"/>
            </HBox>
            <VBox spacing="14" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
                    <TextField fx:id="searchField" promptText="Search source, destination, protocol, or status"
                               styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <Button text="↻  Refresh" onAction="#refresh" styleClass="button-secondary"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel" text="Loading stored observations…" styleClass="status-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="LOCAL HISTORY" styleClass="mini-badge"/>
                </HBox>
                <TableView fx:id="connectionsTable" prefHeight="480">
                    <placeholder><Label text="No network observations are stored yet." styleClass="table-empty"/></placeholder>
                </TableView>
                <Label text="Sentinel does not capture live traffic in this build. This view only displays records already stored locally."
                       wrapText="true" styleClass="notice-text"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
