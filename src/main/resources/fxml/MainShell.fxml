<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" minWidth="820" minHeight="560"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sentinel.controller.MainShellController" stylesheets="@../css/main.css"
            styleClass="app-shell">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding>
                <Insets top="14" right="28" bottom="14" left="28"/>
            </padding>
            <VBox spacing="3">
                <Label text="SECURITY OPERATIONS" styleClass="eyebrow"/>
                <Label fx:id="pageHeading" text="Dashboard" styleClass="topbar-title"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="●  LOCAL CONSOLE" styleClass="environment-badge"/>
            <Label text="S" styleClass="user-avatar"/>
        </HBox>
    </top>
    <left>
        <VBox spacing="8" prefWidth="232" minWidth="205" styleClass="sidebar">
            <padding>
                <Insets top="24" right="16" bottom="18" left="16"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand-row">
                <Label text="S" styleClass="brand-mark"/>
                <VBox spacing="2">
                    <Label text="SENTINEL" styleClass="brand-label"/>
                    <Label text="CYBERSECURITY CENTER" styleClass="sidebar-subtitle"/>
                </VBox>
            </HBox>
            <Label text="WORKSPACE" styleClass="nav-section-label"/>
            <Button fx:id="dashboardButton" text="▦   Dashboard" onAction="#showDashboard"
                    styleClass="nav-button, active" maxWidth="Infinity"/>
            <Button fx:id="threatButton" text="◈   Threat Monitor" onAction="#showThreatMonitor"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="alertsButton" text="⚑   Security Alerts" onAction="#showAlerts"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="networkButton" text="⌁   Network Monitor" onAction="#showNetworkMonitor"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="ipButton" text="◎   IP Intelligence" onAction="#showIpIntelligence"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="incidentsButton" text="▤   Incident Management" onAction="#showIncidents"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Button fx:id="analyticsButton" text="▥   Analytics" onAction="#showAnalytics"
                    styleClass="nav-button" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="6" styleClass="sidebar-status">
                <Label text="TELEMETRY STATUS" styleClass="nav-section-label"/>
                <Label text="No external feeds configured" styleClass="sidebar-status-text" wrapText="true"/>
            </VBox>
            <Button fx:id="settingsButton" text="⚙   Settings" onAction="#showSettings"
                    styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>
</BorderPane>
