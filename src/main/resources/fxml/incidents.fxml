<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sentinel.controller.IncidentController" styleClass="page-scroll">
    <content>
        <VBox spacing="22" styleClass="page-root">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
                <VBox spacing="5">
                    <Label text="Incident management" styleClass="page-title"/>
                    <Label text="Track open cases and resolve incidents when work is complete." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="CASE WORKSPACE" styleClass="mini-badge"/>
            </HBox>
            <VBox spacing="14" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="filter-bar">
                    <TextField fx:id="searchField" promptText="Search incident, assignee, or description"
                               styleClass="search-field" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="severityFilter" promptText="All severities" prefWidth="160"
                              styleClass="filter-combo"/>
                    <Button text="↻  Refresh" onAction="#refresh" styleClass="button-secondary"/>
                    <Button fx:id="resolveButton" text="Resolve selected"
                            onAction="#resolveSelected" styleClass="button-primary" disable="true"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="statusLabel" text="Loading open incidents…" styleClass="status-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="OPEN INCIDENTS" styleClass="mini-badge"/>
                </HBox>
                <TableView fx:id="incidentsTable" prefHeight="480">
                    <placeholder><Label text="No open incidents. New cases will appear here." styleClass="table-empty"/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
