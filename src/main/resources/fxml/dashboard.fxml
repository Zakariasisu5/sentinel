<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sentinel.controller.DashboardController" styleClass="page-scroll">
    <content>
        <VBox spacing="22" styleClass="page-root">
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
                <VBox spacing="5">
                    <Label text="Security overview" styleClass="page-title"/>
                    <Label text="A live view of records stored in this Sentinel instance." styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻  Refresh" onAction="#refresh" styleClass="button-secondary"/>
            </HBox>

            <FlowPane hgap="14" vgap="14" styleClass="metric-grid">
                <VBox spacing="10" minWidth="150" prefWidth="190" styleClass="metric-card">
                    <Label text="SECURITY EVENTS" styleClass="metric-label"/>
                    <Label fx:id="totalEventsValue" text="—" styleClass="metric-value"/>
                    <Label text="Stored event records" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="10" minWidth="150" prefWidth="190" styleClass="metric-card, accent-cyan">
                    <Label text="ACTIVE THREATS" styleClass="metric-label"/>
                    <Label fx:id="activeThreatsValue" text="—" styleClass="metric-value"/>
                    <Label text="Open threat records" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="10" minWidth="150" prefWidth="190" styleClass="metric-card, accent-red">
                    <Label text="CRITICAL ALERTS" styleClass="metric-label"/>
                    <Label fx:id="criticalAlertsValue" text="—" styleClass="metric-value"/>
                    <Label text="Unacknowledged critical" styleClass="metric-detail"/>
                </VBox>
                <VBox spacing="10" minWidth="150" prefWidth="190" styleClass="metric-card, accent-violet">
                    <Label text="NETWORK CONNECTIONS" styleClass="metric-label"/>
                    <Label fx:id="networkConnectionsValue" text="—" styleClass="metric-value"/>
                    <Label text="Stored observations" styleClass="metric-detail"/>
                </VBox>
            </FlowPane>

            <GridPane hgap="16" vgap="16">
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints percentWidth="64" hgrow="ALWAYS"/>
                    <javafx.scene.layout.ColumnConstraints percentWidth="36" hgrow="ALWAYS"/>
                </columnConstraints>
                <VBox spacing="12" styleClass="panel-card" GridPane.columnIndex="0">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <VBox spacing="4">
                            <Label text="Events by severity" styleClass="section-title"/>
                            <Label text="Distribution across locally stored event records" styleClass="section-subtitle"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="LOCAL DATA" styleClass="mini-badge"/>
                    </HBox>
                    <StackPane minHeight="210" prefHeight="250">
                        <BarChart fx:id="severityChart" animated="false" legendVisible="false"
                                  categoryGap="22" barGap="6" styleClass="severity-chart">
                            <xAxis><CategoryAxis side="BOTTOM" animated="false"/></xAxis>
                            <yAxis><NumberAxis side="LEFT" forceZeroInRange="true" animated="false"/></yAxis>
                        </BarChart>
                        <Label fx:id="chartEmptyState" text="No event records are available yet."
                               styleClass="empty-state"/>
                    </StackPane>
                </VBox>
                <VBox spacing="10" styleClass="panel-card" GridPane.columnIndex="1">
                    <Label text="System security overview" styleClass="section-title"/>
                    <Label text="LOCAL DATABASE" styleClass="metric-label"/>
                    <Label fx:id="connectionStatus" text="CHECKING CONNECTION" styleClass="connection-status"/>
                    <Region minHeight="6"/>
                    <Label text="Telemetry sources" styleClass="section-title"/>
                    <Label text="No external feeds are configured. Dashboard metrics reflect records saved locally; no sample or live external data is added."
                           wrapText="true" styleClass="section-subtitle"/>
                </VBox>
            </GridPane>

            <VBox spacing="12" styleClass="panel-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox spacing="4">
                        <Label text="Recent security activity" styleClass="section-title"/>
                        <Label text="Most recent locally recorded events" styleClass="section-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="LATEST 100" styleClass="mini-badge"/>
                </HBox>
                <TableView fx:id="recentEventsTable" prefHeight="280">
                    <placeholder><Label text="No security events have been recorded." styleClass="table-empty"/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
