<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sentinel.controller.DashboardController" styleClass="page-root">
    <children>
        <VBox spacing="18" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
            <Label text="Dashboard Overview" styleClass="page-title"/>
            <Label text="Operational summary, telemetry health, and active security posture." styleClass="page-subtitle"/>
            <Label text="This initial phase establishes the application shell, shared layout, and dashboard entry screen." styleClass="page-body"/>
        </VBox>
    </children>
</AnchorPane>
